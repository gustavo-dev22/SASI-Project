@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card shadow-lg border-0 p-4 text-center" style="width: 100%; max-width: 460px; border-radius: 1rem;">
        <div class="mb-3">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10" style="width: 90px; height: 90px;">
                <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
            </span>
        </div>

        <h4 class="fw-bold text-danger mb-2">Ocurrió un error</h4>
        <p class="text-muted mb-1">Lo sentimos, se produjo un error inesperado al procesar su solicitud.</p>
        <p class="text-muted mb-4">Si el problema persiste, contacte al administrador del sistema.</p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted small mb-4">
                ID de referencia: <code>@Model.RequestId</code>
            </p>
        }

        <a class="btn btn-primary w-100" asp-controller="Home" asp-action="Index">
            <i class="bi bi-house-door-fill me-1"></i> Volver al inicio
        </a>
    </div>
</div>
