@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutLogin";

    var nombreSistema = (ViewBag.NombreSistema as string)?.Trim();

    var tituloFormulario = "Inicia sesión en SASI";
    var subtituloFormulario = "Plataforma de administración de sistemas de información.";

    if (!string.IsNullOrEmpty(nombreSistema))
    {
        // Evita la repetición "Acceso al sistema Sistema de ...": la mayoría de los
        // nombres en SASI ya empiezan por "Sistema", así que se integra al texto
        // sin duplicar la palabra ("Acceso al sistema de Comité de Aula").
        var nombre = nombreSistema;

        if (nombre.StartsWith("Sistema de ", StringComparison.OrdinalIgnoreCase))
            tituloFormulario = $"Acceso al sistema de {nombre.Substring("Sistema de ".Length)}";
        else if (nombre.StartsWith("Sistema ", StringComparison.OrdinalIgnoreCase))
            tituloFormulario = $"Acceso al sistema {nombre.Substring("Sistema ".Length)}";
        else if (nombre.StartsWith("Sistema", StringComparison.OrdinalIgnoreCase))
            tituloFormulario = nombre;
        else
            tituloFormulario = $"Acceso al sistema {nombre}";

        subtituloFormulario = "Usa tus credenciales institucionales para continuar.";
    }
}

@section Styles {
    <style>
        .sasi-login-body {
            margin: 0;
            background: #eef2f7;
            font-family: "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        .auth-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
        }

        /* ===== Panel de marca ===== */
        .auth-brand {
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 3rem 3.5rem;
            color: #fff;
            background: linear-gradient(145deg, #0b1f4b 0%, #14306e 45%, #1d4ed8 100%);
        }

        .auth-brand::before,
        .auth-brand::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            filter: blur(2px);
            opacity: 0.35;
            pointer-events: none;
        }

        .auth-brand::before {
            width: 420px;
            height: 420px;
            right: -160px;
            top: -140px;
            background: radial-gradient(circle at 30% 30%, rgba(96, 165, 250, 0.9), transparent 70%);
        }

        .auth-brand::after {
            width: 360px;
            height: 360px;
            left: -140px;
            bottom: -160px;
            background: radial-gradient(circle at 70% 70%, rgba(34, 211, 238, 0.7), transparent 70%);
        }

        .auth-brand-content {
            position: relative;
            z-index: 1;
        }

        .auth-brand-logo {
            display: inline-flex;
            align-items: center;
            gap: 0.85rem;
            margin-bottom: 3rem;
        }

        .auth-brand-badge {
            width: 52px;
            height: 52px;
            display: grid;
            place-items: center;
            border-radius: 14px;
            font-size: 1.6rem;
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(6px);
        }

        .auth-brand-name {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            line-height: 1;
        }

        .auth-brand-name small {
            display: block;
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.7);
            margin-top: 0.35rem;
        }

        .auth-brand h1 {
            font-size: 2.5rem;
            font-weight: 700;
            line-height: 1.15;
            margin-bottom: 1rem;
        }

        .auth-brand h1 span {
            color: #7dd3fc;
        }

        .auth-brand p.auth-brand-lead {
            font-size: 1.02rem;
            color: rgba(255, 255, 255, 0.8);
            max-width: 32rem;
            margin-bottom: 2.5rem;
        }

        .auth-features {
            display: grid;
            gap: 1rem;
            max-width: 30rem;
        }

        .auth-feature {
            display: flex;
            align-items: flex-start;
            gap: 0.9rem;
            padding: 0.9rem 1rem;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.14);
        }

        .auth-feature i {
            font-size: 1.2rem;
            color: #7dd3fc;
            margin-top: 0.1rem;
        }

        .auth-feature strong {
            display: block;
            font-size: 0.92rem;
        }

        .auth-feature span {
            font-size: 0.82rem;
            color: rgba(255, 255, 255, 0.72);
        }

        .auth-brand-footer {
            position: relative;
            z-index: 1;
            font-size: 0.78rem;
            color: rgba(255, 255, 255, 0.6);
        }

        /* ===== Panel de formulario ===== */
        .auth-panel {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2.5rem 1.5rem;
        }

        .auth-card {
            position: relative;
            width: 100%;
            max-width: 420px;
            background: #fff;
            border-radius: 22px;
            box-shadow: 0 24px 60px rgba(15, 42, 92, 0.16);
            padding: 2.6rem 2.4rem;
        }

        .auth-card-logo {
            display: none;
            align-items: center;
            gap: 0.6rem;
            margin-bottom: 1.5rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #14306e;
        }

        .auth-card-logo .auth-brand-badge {
            background: linear-gradient(145deg, #14306e, #1d4ed8);
            border: none;
            color: #fff;
        }

        .auth-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 0.35rem;
        }

        .auth-subtitle {
            font-size: 0.9rem;
            color: #64748b;
            margin-bottom: 1.75rem;
        }

        .auth-input {
            margin-bottom: 1.1rem;
        }

        .auth-input label {
            display: block;
            font-size: 0.82rem;
            font-weight: 600;
            color: #334155;
            margin-bottom: 0.45rem;
        }

        .auth-input-group {
            display: flex;
            align-items: center;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            background: #f8fafc;
            transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
        }

        .auth-input-group:focus-within {
            border-color: #1d4ed8;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(29, 78, 216, 0.12);
        }

        .auth-input-group i {
            padding: 0 0.35rem 0 1rem;
            color: #94a3b8;
            font-size: 1.05rem;
        }

        .auth-input-group input {
            flex: 1;
            border: 0;
            background: transparent;
            padding: 0.8rem 1rem 0.8rem 0.7rem;
            font-size: 0.95rem;
            color: #0f172a;
            outline: none;
            min-width: 0;
        }

        .auth-input-group input::placeholder {
            color: #94a3b8;
        }

        .auth-input-group .auth-toggle {
            border: 0;
            background: transparent;
            color: #94a3b8;
            padding: 0 1rem;
            cursor: pointer;
            line-height: 1;
        }

        .auth-input-group .auth-toggle:hover {
            color: #1d4ed8;
        }

        .auth-submit {
            width: 100%;
            border: 0;
            border-radius: 12px;
            padding: 0.85rem 1rem;
            font-size: 0.98rem;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(135deg, #14306e 0%, #1d4ed8 100%);
            box-shadow: 0 12px 24px rgba(29, 78, 216, 0.28);
            transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
        }

        .auth-submit:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 16px 30px rgba(29, 78, 216, 0.34);
        }

        .auth-submit:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

        .auth-alert {
            display: flex;
            align-items: flex-start;
            gap: 0.6rem;
            border-radius: 12px;
            padding: 0.8rem 1rem;
            font-size: 0.86rem;
            margin-bottom: 1.25rem;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
        }

        .auth-attempts {
            border-radius: 12px;
            padding: 0.7rem 1rem;
            font-size: 0.84rem;
            margin-top: 1rem;
            background: #fffbeb;
            border: 1px solid #fde68a;
            color: #92400e;
        }

        .auth-footer {
            margin-top: 1.6rem;
            font-size: 0.78rem;
            color: #94a3b8;
            text-align: center;
        }

        .auth-footer a {
            color: #1d4ed8;
            text-decoration: none;
        }

        /* Overlay de carga */
        .auth-overlay {
            position: absolute;
            inset: 0;
            display: none;
            align-items: center;
            justify-content: center;
            border-radius: 22px;
            background: rgba(255, 255, 255, 0.82);
            backdrop-filter: blur(3px);
            z-index: 5;
        }

        .auth-overlay-inner {
            text-align: center;
            color: #14306e;
        }

        .blurred {
            filter: blur(2px);
            pointer-events: none;
            user-select: none;
        }

        /* Modal de cambio de contraseña */
        #cambiarPasswordModal .modal-content {
            border: 0;
            border-radius: 18px;
            overflow: hidden;
        }

        #cambiarPasswordModal .modal-header {
            background: linear-gradient(135deg, #14306e 0%, #1d4ed8 100%);
            color: #fff;
            border: 0;
        }

        #cambiarPasswordModal .modal-title {
            font-size: 1rem;
            font-weight: 600;
        }

        #cambiarPasswordModal .form-control {
            border-radius: 10px;
            padding: 0.7rem 0.9rem;
        }

        #passwordPolicy ul {
            list-style: none;
            padding-left: 0;
            margin: 0.5rem 0 0;
            font-size: 0.82rem;
        }

        @@media (max-width: 991.98px) {
            .auth-shell {
                grid-template-columns: 1fr;
            }

            .auth-brand {
                display: none;
            }

            .auth-panel {
                padding: 2rem 1.25rem;
            }

            .auth-card-logo {
                display: flex;
            }
        }
    </style>
}

<div class="auth-shell">
    <!-- Panel de marca -->
    <aside class="auth-brand">
        <div class="auth-brand-content">
            <div class="auth-brand-logo">
                <span class="auth-brand-badge"><i class="bi bi-diagram-3-fill"></i></span>
                <span class="auth-brand-name">
                    SASI
                    <small>Administración de Sistemas</small>
                </span>
            </div>

            <h1>Gobierno y control de tus <span>sistemas de información</span></h1>
            <p class="auth-brand-lead">
                Centraliza usuarios, roles, accesos y auditoría en una sola plataforma,
                con inicio de sesión único para todos los sistemas integrados.
            </p>

            <div class="auth-features">
                <div class="auth-feature">
                    <i class="bi bi-people-fill"></i>
                    <div>
                        <strong>Gestión centralizada</strong>
                        <span>Usuarios, roles y permisos por sistema.</span>
                    </div>
                </div>
                <div class="auth-feature">
                    <i class="bi bi-shield-lock-fill"></i>
                    <div>
                        <strong>Acceso seguro</strong>
                        <span>Autenticación única y control por módulo y acción.</span>
                    </div>
                </div>
                <div class="auth-feature">
                    <i class="bi bi-clipboard-data-fill"></i>
                    <div>
                        <strong>Auditoría y trazabilidad</strong>
                        <span>Registro de actividad y gobernanza de TI.</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="auth-brand-footer">
            &copy; @DateTime.Now.Year SASI &middot; Oficina de Tecnologías de la Información
        </div>
    </aside>

    <!-- Panel de formulario -->
    <main class="auth-panel">
        <div class="auth-card" id="loginCard">
            <div id="loadingOverlay" class="auth-overlay">
                <div class="auth-overlay-inner">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 fw-bold mb-0">Cargando...</p>
                </div>
            </div>

            <div class="auth-card-logo">
                <span class="auth-brand-badge"><i class="bi bi-diagram-3-fill"></i></span>
                <span class="auth-brand-name">SASI</span>
            </div>

            <h2 class="auth-title">@tituloFormulario</h2>
            <p class="auth-subtitle">@subtituloFormulario</p>

            @if (!string.IsNullOrEmpty(ViewBag.ErrorSso as string))
            {
                <div class="auth-alert">
                    <i class="bi bi-exclamation-octagon-fill"></i>
                    <span>@ViewBag.ErrorSso</span>
                </div>
            }

            <form asp-action="Login" method="post" id="loginForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <input type="hidden" name="client_id" value="@ViewBag.ClientId" />
                <input type="hidden" name="state" value="@ViewBag.State" />
                <input type="hidden" name="code_challenge" value="@ViewBag.CodeChallenge" />
                <input type="hidden" name="code_challenge_method" value="@ViewBag.CodeChallengeMethod" />

                <div class="auth-input">
                    <label for="userName">Nombre de usuario</label>
                    <div class="auth-input-group">
                        <i class="bi bi-person-fill"></i>
                        <input id="userName" name="userName" type="text" placeholder="ej: admin" autocomplete="username" />
                    </div>
                </div>

                <div class="auth-input">
                    <label for="password">Contraseña</label>
                    <div class="auth-input-group">
                        <i class="bi bi-lock-fill"></i>
                        <input id="password" name="password" type="password" placeholder="••••••••" autocomplete="current-password" />
                        <button type="button" class="auth-toggle" id="btnTogglePassword" title="Mostrar u ocultar contraseña" aria-label="Mostrar u ocultar contraseña">
                            <i class="bi bi-eye-fill" id="iconTogglePassword"></i>
                        </button>
                    </div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-alert">
                        <i class="bi bi-exclamation-octagon-fill"></i>
                        <span>@(ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage)</span>
                    </div>
                }

                <button type="button" class="auth-submit" id="btnLogin">Ingresar</button>

                @if (TempData["intentosRestantes"] != null)
                {
                    <div class="auth-attempts">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Te quedan @TempData["intentosRestantes"] intento(s) antes de que tu cuenta sea bloqueada.
                    </div>
                }
            </form>
        </div>

        <p class="auth-footer">
            &copy; @DateTime.Now.Year SASI &middot; <a href="#">Política de privacidad</a>
        </p>
    </main>
</div>

<!-- Modal de cambio de contraseña -->
<div class="modal fade" id="cambiarPasswordModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" role="dialog" aria-labelledby="cambiarPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <form action="@Url.Content("~/Cuenta/CambiarPasswordObligatorio")" method="post" id="formCambioPassword">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userName" id="userNameCambioPassword" value="" />
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <input type="hidden" name="client_id" value="@ViewBag.ClientId" />
            <input type="hidden" name="state" value="@ViewBag.State" />
            <input type="hidden" name="code_challenge" value="@ViewBag.CodeChallenge" />
            <input type="hidden" name="code_challenge_method" value="@ViewBag.CodeChallengeMethod" />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="cambiarPasswordModalLabel">
                        <i class="bi bi-shield-lock-fill me-1"></i> Cambio de contraseña obligatorio
                    </h5>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="form-label">Nueva contraseña</label>
                        <input type="password" name="nuevaPassword" class="form-control" id="nuevaPassword" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Confirmar nueva contraseña</label>
                        <input type="password" name="confirmarPassword" class="form-control" id="confirmarPassword" />
                    </div>

                    <div id="passwordPolicy" class="mt-2"></div>

                    <div class="text-danger mt-2" id="errorCambioPassword">
                        @ViewBag.Error
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="btnCambiarPassword">Cambiar contraseña</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("btnLogin").addEventListener("click", function (e) {
            e.preventDefault(); // Evitar envío tradicional

            const userNameInput = document.getElementById("userName");
            const passwordInput = document.getElementById("password");

            const userName = userNameInput.value.trim();
            const password = passwordInput.value.trim();

            if (!userName) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Usuario requerido',
                    text: 'Por favor, ingresa tu nombre de usuario.',
                    confirmButtonText: 'Aceptar',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then(() => userNameInput.focus());
                return;
            }

            if (!password) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Contraseña requerida',
                    text: 'Por favor, ingresa tu contraseña.',
                    confirmButtonText: 'Aceptar',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then(() => passwordInput.focus());
                return;
            }

            const overlay = document.getElementById("loadingOverlay");
            const card = document.getElementById("loginCard");

            overlay.style.display = "flex";
            card.classList.add("blurred");

            // Se obtiene un token antiforgery fresco antes de enviar. Con SSO la
            // pagina se alcanza por navegacion cross-site y la cookie
            // `.SASI.Antiforgery` puede quedar desincronizada respecto al token
            // renderizado (varias pestanas, sesion previa, cache), lo que provoca
            // 400 en el POST. Pedir el token por AJAX garantiza que token y cookie
            // correspondan al mismo estado en el momento del envio.
            $.get('@Url.Content("~/Cuenta/ObtenerTokenAntiForgery")')
                .always(function (respuesta) {
                    const tokenAntiForgery = (respuesta && respuesta.token)
                        ? respuesta.token
                        : $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Content("~/Cuenta/Login")',
                type: 'POST',
                data: {
                    userName: userName,
                    password: password,
                    returnUrl: $('input[name="returnUrl"]').val(),
                    client_id: $('input[name="client_id"]').val(),
                    state: $('input[name="state"]').val(),
                    code_challenge: $('input[name="code_challenge"]').val(),
                    code_challenge_method: $('input[name="code_challenge_method"]').val(),
                    __RequestVerificationToken: tokenAntiForgery
                },
                success: function (data) {
                    overlay.style.display = "none";
                    card.classList.remove("blurred");

                    if (data.success) {
                        window.location.href = data.redirectUrl;
                    } else {
                        switch (data.tipo) {
                            case "inactivo":
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Cuenta inactiva',
                                    text: 'Tu cuenta está inactiva. Contacta al administrador.',
                                    confirmButtonText: 'Aceptar',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                break;
                            case "bloqueado":
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Cuenta bloqueada',
                                    text: 'Tu cuenta ha sido bloqueada por múltiples intentos fallidos.',
                                    confirmButtonText: 'Aceptar',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                break;
                            case "sinRol":
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Sin rol asignado',
                                    text: 'No tienes roles activos en SASI.',
                                    confirmButtonText: 'Aceptar',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                break;
                            case "cambioPasswordObligatorio":
                            case "passwordVencida":
                                    // Regenerar el token antes de mostrar el modal
                                $.get('@Url.Content("~/Cuenta/ObtenerTokenAntiForgery")', function (data) {
                                    $('input[name="__RequestVerificationToken"]').val(data.token); // actualiza el token del formulario del modal

                                    $("#userNameCambioPassword").val($("#userName").val());
                                    $('#cambiarPasswordModal').modal('show');
                                });
                                break;
                            case "credencialesInvalidas":
                                const tieneIntentos = data.intentosRestantes !== undefined && data.intentosRestantes !== null;
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Credenciales inválidas',
                                    text: tieneIntentos
                                        ? `Correo o contraseña incorrectos. Intentos restantes: ${data.intentosRestantes}`
                                        : 'Usuario o contraseña incorrectos',
                                    confirmButtonText: 'Aceptar',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                break;
                            case "usuarioNoExiste":
                            default:
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error de inicio de sesión',
                                    text: 'No se pudo iniciar sesión. Verifica tus datos.',
                                    confirmButtonText: 'Aceptar',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                break;
                        }
                    }
                },
                error: function () {
                    overlay.style.display = "none";
                    card.classList.remove("blurred");

                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Ocurrió un error inesperado en el servidor.',
                        confirmButtonText: 'Aceptar',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            });
                });
        });
    </script>

    <script>
        // Mostrar / ocultar contraseña
        (function () {
            const toggle = document.getElementById("btnTogglePassword");
            const passwordInput = document.getElementById("password");
            const icon = document.getElementById("iconTogglePassword");

            if (!toggle || !passwordInput) return;

            toggle.addEventListener("click", function () {
                const esTexto = passwordInput.type === "text";
                passwordInput.type = esTexto ? "password" : "text";
                icon.classList.toggle("bi-eye-fill", esTexto);
                icon.classList.toggle("bi-eye-slash-fill", !esTexto);
            });
        })();
    </script>

    <script>
        function prevenirEspaciosYCopiar(inputId) {
            const input = document.getElementById(inputId);

            if (!input) return;

            // Prevenir espacios en tiempo real
            input.addEventListener('keydown', function (e) {
                if (e.key === ' ' || e.code === 'Space') {
                    e.preventDefault();
                }
            });

            // Remover espacios pegados
            input.addEventListener('input', function () {
                this.value = this.value.replace(/\s/g, '');
            });

            // Bloquear copiar, cortar y pegar
            ['copy', 'cut', 'paste', 'contextmenu'].forEach(evt => {
                input.addEventListener(evt, function (e) {
                    e.preventDefault();
                });
            });

            // Bloquear Ctrl+C, Ctrl+X, Ctrl+V
            input.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && ['c', 'x', 'v'].includes(e.key.toLowerCase())) {
                    e.preventDefault();
                }
            });
        }

        // Aplicar la función a los campos
        prevenirEspaciosYCopiar('userName');
        prevenirEspaciosYCopiar('password');
    </script>

    <script>
        $(document).ready(function () {
            const policyDiv = $("#passwordPolicy");
            const passwordInput = $("#nuevaPassword");

            function validarPassword(password) {
                const reglas = [
                    { regex: /.{8,}/, mensaje: "Mínimo 8 caracteres" },
                    { regex: /[A-Z]/, mensaje: "Al menos una letra mayúscula" },
                    { regex: /[a-z]/, mensaje: "Al menos una letra minúscula" },
                    { regex: /[0-9]/, mensaje: "Al menos un número" },
                    { regex: /[^A-Za-z0-9]/, mensaje: "Al menos un carácter especial" }
                ];

                let html = "<ul>";
                reglas.forEach(regla => {
                    const cumple = regla.regex.test(password);
                    html += `<li style="color: ${cumple ? 'green' : 'red'}">${regla.mensaje}</li>`;
                });
                html += "</ul>";
                policyDiv.html(html);
            }

            passwordInput.on("input", function () {
                validarPassword($(this).val());
            });
        });
    </script>

    <script>
        document.getElementById("btnCambiarPassword").addEventListener("click", function () {
            const nuevaPassword = document.getElementById("nuevaPassword").value.trim();
            const confirmarPassword = document.getElementById("confirmarPassword").value.trim();

            const reglas = [
                { regex: /.{8,}/, mensaje: "Mínimo 8 caracteres" },
                { regex: /[A-Z]/, mensaje: "Al menos una letra mayúscula" },
                { regex: /[a-z]/, mensaje: "Al menos una letra minúscula" },
                { regex: /[0-9]/, mensaje: "Al menos un número" },
                { regex: /[^A-Za-z0-9]/, mensaje: "Al menos un carácter especial" }
            ];

            if (!nuevaPassword || !confirmarPassword) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Campos requeridos',
                    text: 'Por favor completa ambos campos de contraseña.',
                    confirmButtonText: 'Aceptar',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });
                return;
            }

            if (nuevaPassword !== confirmarPassword) {
                Swal.fire({
                    icon: 'error',
                    title: 'Contraseñas no coinciden',
                    text: 'La nueva contraseña y su confirmación deben ser iguales.',
                    confirmButtonText: 'Aceptar',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });
                return;
            }

            const fallas = reglas.filter(r => !r.regex.test(nuevaPassword));
            if (fallas.length > 0) {
                let listaErrores = fallas.map(f => `<li>${f.mensaje}</li>`).join('');
                Swal.fire({
                    icon: 'warning',
                    title: 'Contraseña inválida',
                    html: `<ul style="text-align: left;">${listaErrores}</ul>`,
                    confirmButtonText: 'Aceptar',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });
                return;
            }

            Swal.fire({
                title: 'Procesando...',
                text: 'Estamos actualizando tu contraseña.',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            setTimeout(() => {

                const form = document.getElementById("formCambioPassword");

                Swal.fire({
                    icon: 'success',
                    title: 'Contraseña actualizada',
                    text: 'Se ha cambiado la contraseña correctamente. Serás redirigido al inicio de sesión.',
                    confirmButtonText: 'Aceptar',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then(() => {
                    form.submit();
                });
            }, 3000);
        });
    </script>
}
