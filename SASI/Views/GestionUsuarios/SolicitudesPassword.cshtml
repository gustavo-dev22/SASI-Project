@model SASI.Models.SolicitudesPasswordViewModel
@using SASI.Dominio.Modelo
@{
    ViewBag.Title = "Solicitudes de contraseña";
}

<div class="d-flex justify-content-between align-items-center mt-5 mb-3">
    <h2 class="mb-0"><i class="bi bi-key-fill"></i> Solicitudes de contraseña</h2>
    <a href="@Url.Action("Index", "GestionUsuarios")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver a usuarios
    </a>
</div>

<p class="text-muted">
    Solicitudes enviadas por los usuarios desde el login de SASI. Al restablecer, se genera una
    contraseña temporal, se desbloquea la cuenta y el usuario deberá cambiarla al ingresar.
    Comunica la contraseña temporal por un canal seguro.
</p>

<h5 class="mt-4">Pendientes <span class="badge bg-danger">@Model.Pendientes.Count</span></h5>

@if (!Model.Pendientes.Any())
{
    <div class="alert alert-info">No hay solicitudes pendientes.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-header-custom">
                <tr>
                    <th>Fecha</th>
                    <th>Usuario</th>
                    <th>Sistema</th>
                    <th>Identificador</th>
                    <th>Mensaje</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Pendientes)
                {
                    <tr>
                        <td>@s.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <strong>@(s.NombreCompleto ?? s.UserName ?? "-")</strong><br />
                            <small class="text-muted">@s.UserName</small><br />
                            <small class="text-muted">@s.Email</small>
                        </td>
                        <td>@(s.SistemaNombre ?? "SASI (consola)")</td>
                        <td>@s.Identificador</td>
                        <td>@(string.IsNullOrWhiteSpace(s.Mensaje) ? "-" : s.Mensaje)</td>
                        <td class="text-center" style="white-space:nowrap">
                            <button class="btn btn-sm btn-danger me-1" onclick="restablecerSolicitud(@s.IdSolicitud)">
                                <i class="bi bi-key-fill"></i> Restablecer
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" onclick="rechazarSolicitud(@s.IdSolicitud)">
                                <i class="bi bi-x-lg"></i> Rechazar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="row mt-5">
    <div class="col-md-6">
        <h5>Atendidas <span class="badge bg-success">@Model.Atendidas.Count</span></h5>
        @if (!Model.Atendidas.Any())
        {
            <p class="text-muted small">Sin registros.</p>
        }
        else
        {
            <table class="table table-sm table-bordered">
                <thead>
                    <tr><th>Fecha</th><th>Usuario</th><th>Atendido por</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Atendidas)
                    {
                        <tr>
                            <td>@(s.FechaRespuesta?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td>@(s.NombreCompleto ?? s.UserName ?? s.Identificador)</td>
                            <td>@s.AtendidoPor</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="col-md-6">
        <h5>Rechazadas <span class="badge bg-secondary">@Model.Rechazadas.Count</span></h5>
        @if (!Model.Rechazadas.Any())
        {
            <p class="text-muted small">Sin registros.</p>
        }
        else
        {
            <table class="table table-sm table-bordered">
                <thead>
                    <tr><th>Fecha</th><th>Usuario</th><th>Atendido por</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Rechazadas)
                    {
                        <tr>
                            <td>@(s.FechaRespuesta?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td>@(s.NombreCompleto ?? s.UserName ?? s.Identificador)</td>
                            <td>@s.AtendidoPor</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
    <script>
        function mostrarPasswordTemporal(temporal) {
            return Swal.fire({
                title: 'Contraseña temporal',
                html: `<p class="mb-2">Comunícala al usuario por un canal seguro. Deberá cambiarla al ingresar.</p>
                       <div class="input-group">
                         <input id="tempPass" class="form-control text-center fw-bold" readonly value="${temporal}" />
                         <button class="btn btn-outline-primary" id="btnCopyTemp" type="button">Copiar</button>
                       </div>`,
                icon: 'success',
                confirmButtonText: 'Listo',
                allowOutsideClick: false,
                didOpen: () => {
                    const btn = document.getElementById('btnCopyTemp');
                    if (btn) {
                        btn.addEventListener('click', () => {
                            navigator.clipboard.writeText(temporal);
                            btn.textContent = 'Copiado';
                        });
                    }
                }
            });
        }

        function restablecerSolicitud(idSolicitud) {
            Swal.fire({
                title: 'Restablecer contraseña',
                text: '¿Generar una contraseña temporal para el usuario de esta solicitud? Se desbloqueará la cuenta.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Restablecer',
                cancelButtonText: 'Cancelar'
            }).then((r) => {
                if (!r.isConfirmed) return;

                $.post('@Url.Action("RestablecerSolicitud", "GestionUsuarios")', { idSolicitud }, function (resp) {
                    if (!resp.success) {
                        Swal.fire('Error', resp.message || 'No se pudo restablecer la contraseña.', 'error');
                        return;
                    }
                    mostrarPasswordTemporal(resp.temporal).then(() => location.reload());
                }).fail(function () {
                    Swal.fire('Error', 'Ocurrió un error al restablecer la contraseña.', 'error');
                });
            });
        }

        function rechazarSolicitud(idSolicitud) {
            Swal.fire({
                title: 'Rechazar solicitud',
                input: 'textarea',
                inputLabel: 'Comentario (opcional)',
                inputPlaceholder: 'Motivo del rechazo...',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Rechazar',
                cancelButtonText: 'Cancelar'
            }).then((r) => {
                if (!r.isConfirmed) return;

                $.post('@Url.Action("RechazarSolicitud", "GestionUsuarios")', { idSolicitud, comentario: r.value }, function (resp) {
                    if (!resp.success) {
                        Swal.fire('Error', resp.message || 'No se pudo rechazar la solicitud.', 'error');
                        return;
                    }
                    Swal.fire('Rechazada', resp.message, 'success').then(() => location.reload());
                }).fail(function () {
                    Swal.fire('Error', 'Ocurrió un error al rechazar la solicitud.', 'error');
                });
            });
        }
    </script>
}
