@{
    ViewData["Title"] = "Solicitud enviada";
    Layout = "_LayoutLogin";

    var volverLoginUrl = Url.Action("Login", "Cuenta", new
    {
        client_id = ViewBag.ClientId as string,
        returnUrl = ViewBag.ReturnUrl as string,
        state = ViewBag.State as string,
        code_challenge = ViewBag.CodeChallenge as string,
        code_challenge_method = ViewBag.CodeChallengeMethod as string
    });
}

@section Styles {
    <style>
        .rec-wrap {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            background: linear-gradient(145deg, #0b1f4b 0%, #14306e 45%, #1d4ed8 100%);
            font-family: "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        .rec-card {
            width: 100%;
            max-width: 480px;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 18px 45px rgba(2, 6, 23, 0.35);
            padding: 2.5rem;
        }
    </style>
}

<div class="rec-wrap">
    <div class="rec-card text-center">
        <i class="bi bi-check-circle-fill text-success" style="font-size:3rem;"></i>

        <h1 class="h4 fw-bold mt-3 mb-2">Solicitud enviada</h1>
        <p class="text-muted mb-4">
            Si los datos ingresados corresponden a una cuenta registrada, un administrador
            gestionará tu solicitud y te entregará una contraseña temporal. Al ingresar,
            el sistema te pedirá cambiarla.
        </p>

        <a href="@volverLoginUrl" class="btn btn-primary">
            <i class="bi bi-box-arrow-in-right"></i> Volver al inicio de sesión
        </a>
    </div>
</div>
