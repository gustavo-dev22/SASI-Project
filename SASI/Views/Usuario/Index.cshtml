@using X.PagedList
@using X.PagedList.Mvc.Core

@model UsuarioSistemaViewModel

@{
    ViewData["Title"] = "Usuarios del Sistema";
}

<h2 class="mt-5">Gestión de Usuarios del Sistema: <b><u>@Model.NombreSistema</u></b>
    <span class="text-muted fs-5">(@Model.UsuariosAsignados.TotalItemCount)</span>
</h2>

<div class="d-flex justify-content-between align-items-center mb-3 mt-5">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAgregarUsuario">
        <i class="bi bi-person-plus"></i> Agregar Usuario
    </button>

    <a href="@Url.Action("Index", "Sistema")" class="btn btn-secondary mb-3">
        <i class="bi bi-arrow-left-circle"></i> Regresar
    </a>
</div>

<table class="table table-bordered table-hover align-middle text-center">
    <thead class="table-header-custom">
        <tr>
            <th>#</th>
            <th>Correo</th>
            <th>Nombre</th>
            <th>Rol</th>
            <th>Principal</th>
            <th>Fecha Asignación</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.UsuariosAsignados.Any())
        {
            <tr>
                <td colspan="7" class="text-muted fst-italic">No hay usuarios asignados a este sistema.</td>
            </tr>
        }
        else
        {
            @for (int i = 0; i < Model.UsuariosAsignados.Count; i++)
            {
                var u = Model.UsuariosAsignados[i];
                <tr>
                    <td>@(((Model.UsuariosAsignados.PageNumber - 1) * Model.UsuariosAsignados.PageSize) + i + 1)</td>
                    <td>@u.Email</td>
                    <td>@u.NombreCompleto</td>
                    <td>@u.Rol</td>
                    <td>
                        @if (u.EsPrincipal)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> Principal</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>@u.FechaAsignacion.ToString("dd/MM/yyyy")</td>
                    <td>
                        <button class="btn btn-danger btn-sm" title="Quitar relación usuario-rol"
                                onclick="quitarUsuario('@u.UsuarioId.ToString()', @u.RolId, @u.EsPrincipal.ToString().ToLower())">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<div class="d-flex justify-content-center mt-3">
    @Html.PagedListPager(Model.UsuariosAsignados, page => Url.Action("Index", new { sistemaId = Model.SistemaId, page }),
        new PagedListRenderOptions
        {
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            UlElementClasses = new[] { "pagination" },
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" }
        })
</div>

<!-- Modal agregar usuario (asignar usuario existente al sistema) -->
<div class="modal fade" id="modalAgregarUsuario" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formAsignarUsuario">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalLabel">Agregar Usuario al Sistema</h5>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="sistemaId" value="@Model.SistemaId" />

                    <div class="mb-3">
                        <label for="usuarioSelect" class="form-label">Usuario</label>
                        <select id="usuarioSelect" class="form-select" required>
                            <option value="">Cargando usuarios...</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="rolSelect" class="form-label">Rol</label>
                        <select id="rolSelect" class="form-select" required>
                            <option value="">Seleccione un rol</option>
                            @foreach (var rol in Model.RolesDisponibles)
                            {
                                <option value="@rol.Value">@rol.Text</option>
                            }
                        </select>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="esPrincipalCheck">
                        <label class="form-check-label" for="esPrincipalCheck">¿Es principal?</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Asignar</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        const sistemaId = @Model.SistemaId;
        const token = document.querySelector('meta[name="RequestVerificationToken"]')?.getAttribute('content') || '';

        // Cargar usuarios disponibles al abrir el modal
        $('#modalAgregarUsuario').on('show.bs.modal', function () {
            const $select = $('#usuarioSelect');
            $select.empty().append('<option value="">Cargando usuarios...</option>');
            $select.prop('disabled', true);

            fetch('@Url.Action("ObtenerUsuariosDisponibles", "Usuario")?sistemaId=' + sistemaId)
                .then(r => r.json())
                .then(data => {
                    $select.empty();
                    if (data.length === 0) {
                        $select.append('<option value="">No hay usuarios disponibles</option>');
                    } else {
                        $select.append('<option value="">Seleccione un usuario</option>');
                        data.forEach(u => {
                            $select.append(`<option value="${u.id}">${u.nombreCompleto} (${u.email})</option>`);
                        });
                    }
                    $select.prop('disabled', false);
                })
                .catch(() => {
                    $select.empty().append('<option value="">Error al cargar usuarios</option>');
                    $select.prop('disabled', false);
                });
        });

        // Asignar usuario al sistema
        $('#formAsignarUsuario').on('submit', function (e) {
            e.preventDefault();

            const usuarioId = $('#usuarioSelect').val();
            const rolId = $('#rolSelect').val();
            const esPrincipal = $('#esPrincipalCheck').is(':checked');

            if (!usuarioId || !rolId) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Campos requeridos',
                    text: 'Seleccione un usuario y un rol.',
                    confirmButtonText: 'Aceptar',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });
                return;
            }

            Swal.fire({
                title: '¿Desea asignar el usuario al sistema?',
                text: 'Se registrará la asignación con el rol seleccionado.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, asignar',
                cancelButtonText: 'Cancelar',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then(result => {
                if (!result.isConfirmed) return;

                const body = new URLSearchParams();
                body.append('sistemaId', sistemaId);
                body.append('usuarioId', usuarioId);
                body.append('rolId', rolId);
                body.append('esPrincipal', esPrincipal);

                fetch('@Url.Action("AsignarUsuario", "Usuario")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: body.toString()
                })
                .then(r => r.json())
                .then(data => {
                    Swal.fire({
                        icon: data.success ? 'success' : 'error',
                        title: data.message,
                        confirmButtonText: 'Aceptar',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    }).then(() => {
                        if (data.success) {
                            $('#modalAgregarUsuario').modal('hide');
                            location.reload();
                        }
                    });
                })
                .catch(err => {
                    console.error(err);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Ocurrió un error al asignar el usuario.',
                        confirmButtonText: 'Aceptar',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                });
            });
        });

        // Quitar relación usuario-rol del sistema
        window.quitarUsuario = function (usuarioId, rolId, esPrincipal) {
            if (esPrincipal) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Rol principal',
                    text: 'No se puede quitar el rol principal. Asigne otro rol principal antes de quitar esta relación.',
                    confirmButtonText: 'Aceptar',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });
                return;
            }

            Swal.fire({
                title: '¿Está seguro?',
                text: '¿Desea quitar esta relación usuario-rol del sistema?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, quitar',
                cancelButtonText: 'Cancelar',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then(result => {
                if (!result.isConfirmed) return;

                const body = new URLSearchParams();
                body.append('sistemaId', sistemaId);
                body.append('usuarioId', usuarioId);
                body.append('rolId', rolId);

                fetch('@Url.Action("QuitarUsuarioDeSistema", "Usuario")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: body.toString()
                })
                .then(r => r.json())
                .then(data => {
                    Swal.fire({
                        icon: data.success ? 'success' : 'error',
                        title: data.message,
                        confirmButtonText: 'Aceptar',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    }).then(() => {
                        if (data.success) location.reload();
                    });
                })
                .catch(err => {
                    console.error(err);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'No se pudo quitar la relación usuario-rol.',
                        confirmButtonText: 'Aceptar',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                });
            });
        };
    });
</script>
}
