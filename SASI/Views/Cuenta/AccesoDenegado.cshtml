@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card shadow-lg border-0 p-4 text-center" style="width: 100%; max-width: 460px; border-radius: 1rem;">
        <div class="mb-3">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10" style="width: 90px; height: 90px;">
                <i class="bi bi-shield-lock-fill text-danger" style="font-size: 3rem;"></i>
            </span>
        </div>

        <h4 class="fw-bold text-danger mb-2">Acceso denegado</h4>
        <p class="text-muted mb-4">
            No cuenta con los permisos necesarios para acceder a este recurso.
            Si considera que esto es un error, contacte al administrador del sistema.
        </p>

        <a class="btn btn-primary w-100 mb-2" asp-controller="Home" asp-action="Index">
            <i class="bi bi-house-door-fill me-1"></i> Volver al inicio
        </a>
        <form asp-controller="Cuenta" asp-action="Logout" method="post" class="d-inline w-100">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary w-100">
                <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
            </button>
        </form>
    </div>
</div>
