@model HomeIndexViewModel

@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold">Bienvenido al Sistema de Administración SASI</h2>
        <p class="text-muted">Seleccione una opción para continuar</p>
    </div>

    @if (Model.EsAdministrador && Model.Dashboard != null)
    {
        var d = Model.Dashboard;

        <div class="row g-3 mb-5">
            <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                <div class="card shadow-sm h-100 border-start border-4 border-primary">
                    <div class="card-body text-center">
                        <i class="bi bi-diagram-3-fill display-5 text-primary"></i>
                        <h3 class="fw-bold mb-0">@d.TotalSistemas</h3>
                        <span class="text-muted">Sistemas</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                <div class="card shadow-sm h-100 border-start border-4 border-success">
                    <div class="card-body text-center">
                        <i class="bi bi-check-circle-fill display-5 text-success"></i>
                        <h3 class="fw-bold mb-0">@d.SistemasActivos</h3>
                        <span class="text-muted">Activos</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                <div class="card shadow-sm h-100 border-start border-4 border-danger">
                    <div class="card-body text-center">
                        <i class="bi bi-x-circle-fill display-5 text-danger"></i>
                        <h3 class="fw-bold mb-0">@d.SistemasInactivos</h3>
                        <span class="text-muted">Inactivos</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                <div class="card shadow-sm h-100 border-start border-4 border-info">
                    <div class="card-body text-center">
                        <i class="bi bi-people-fill display-5 text-info"></i>
                        <h3 class="fw-bold mb-0">@d.TotalUsuarios</h3>
                        <span class="text-muted">Usuarios</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                <div class="card shadow-sm h-100 border-start border-4 border-warning">
                    <div class="card-body text-center">
                        <i class="bi bi-person-badge-fill display-5 text-warning"></i>
                        <h3 class="fw-bold mb-0">@d.TotalRoles</h3>
                        <span class="text-muted">Roles</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                <div class="card shadow-sm h-100 border-start border-4 border-secondary">
                    <div class="card-body text-center">
                        <i class="bi bi-building-fill display-5 text-secondary"></i>
                        <h3 class="fw-bold mb-0">@d.TotalOficinas</h3>
                        <span class="text-muted">Oficinas</span>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row justify-content-center">
        @foreach (var item in Model.MenuItems)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="@item.Icono display-4 text-primary"></i>
                        <h5 class="card-title mt-3">@item.Nombre</h5>
                        <p class="card-text">@item.Nombre</p>
                        <a href="@item.Url" class="btn btn-primary w-100">
                            Ir a @item.Nombre
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    window.onload = function () {
        var mostrarModal = '@ViewBag.MostrarModalPassword' === 'True';
        if (mostrarModal) {
            var emailUsuario = '@User.Identity?.Name';
            document.getElementById("emailCambioPassword").value = emailUsuario;
            var error = '@ViewBag.ErrorCambioPassword';
            if (error) {
                document.getElementById("errorCambioPassword").innerText = error;
            }
            var modal = new bootstrap.Modal(document.getElementById('cambiarPasswordModal'));
            modal.show();
        }
    };
</script>
