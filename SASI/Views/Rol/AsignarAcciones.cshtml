@using SASI.Dominio.Modelo
@model PermisoRolViewModel

@{
    ViewData["Title"] = "Permisos por Acción";
    var seleccionados = new HashSet<string>(Model.PermisosSeleccionados ?? new List<string>());
    var acciones = Model.Acciones.OrderBy(a => a.Orden).ToList();
    var objetos = Model.Objetos.OrderBy(o => o.Orden).ToList();
}

<div class="container mt-4">
    <div class="card shadow rounded-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                Permisos por acción — Rol: <strong>@Model.NombreRol</strong>
                <span class="text-white-50 fs-6">(@Model.NombreSistema)</span>
            </h5>
            <a asp-action="Index" asp-route-sistemaId="@Model.IdSistema" class="btn btn-sm btn-outline-light">
                <i class="bi bi-arrow-left-circle"></i> Regresar
            </a>
        </div>
        <div class="card-body">
            @if (!objetos.Any())
            {
                <div class="alert alert-warning mb-0">
                    El rol no tiene módulos (objetos con URL) asignados. Asigne primero los objetos
                    al rol desde la opción <strong>Asignar Objetos</strong> para poder configurar sus acciones.
                </div>
            }
            else
            {
                <p class="text-muted">
                    Se listan solo los módulos con URL (páginas accionables); los menús contenedores
                    no se incluyen. <strong>LISTAR</strong> es implícito: se concede automáticamente
                    para todo objeto que tenga al menos una acción.
                </p>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle text-center" id="tablaPermisos">
                        <thead class="table-header-custom">
                            <tr>
                                <th class="text-start">Objeto</th>
                                <th style="width:90px;">Tipo</th>
                                @foreach (var accion in acciones)
                                {
                                    if (accion.Codigo == AccionesSistema.Listar)
                                    {
                                        <th style="width:110px;">@accion.Nombre <span class="text-muted fw-normal">(implícito)</span></th>
                                    }
                                    else
                                    {
                                        <th style="width:110px;">@accion.Nombre</th>
                                    }
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var obj in objetos)
                            {
                                if (!obj.Activo) { continue; }
                                <tr data-idobjeto="@obj.IdObjeto">
                                    <td class="text-start">@obj.Nombre</td>
                                    <td><span class="badge bg-secondary">@obj.Tipo</span></td>
                                    @foreach (var accion in acciones)
                                    {
                                        var key = $"{obj.IdObjeto}:{accion.IdAccion}";
                                        var check = seleccionados.Contains(key);
                                        if (accion.Codigo == AccionesSistema.Listar)
                                        {
                                            <td title="Implícito: se concede junto con cualquier otra acción">
                                                <input type="checkbox" class="form-check-input" checked disabled />
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                <input type="checkbox"
                                                       class="form-check-input chk-permiso"
                                                       data-idobjeto="@obj.IdObjeto"
                                                       data-idaccion="@accion.IdAccion"
                                                       data-codigo="@accion.Codigo"
                                                       @(check ? "checked" : "") />
                                            </td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-4 text-end">
                    <button type="button" class="btn btn-success" id="btnGuardarPermisos">
                        <i class="bi bi-save"></i> Guardar Permisos
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.getElementById('btnGuardarPermisos').addEventListener('click', function () {
                const permisos = [];
                document.querySelectorAll('#tablaPermisos tbody tr').forEach(function (fila) {
                    // LISTAR es implícito (checkbox deshabilitado) => no se envía.
                    fila.querySelectorAll('.chk-permiso:checked:not(:disabled)').forEach(function (chk) {
                        permisos.push({
                            idObjeto: parseInt(chk.dataset.idobjeto, 10),
                            idAccion: parseInt(chk.dataset.idaccion, 10)
                        });
                    });
                });

                Swal.fire({
                    title: '¿Desea guardar los permisos?',
                    text: 'Se actualizarán las acciones concedidas al rol.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, guardar',
                    cancelButtonText: 'Cancelar',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    fetch('@Url.Action("GuardarAsignacionAcciones", "Rol")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ idRol: @Model.IdRol, permisos: permisos })
                    })
                    .then(r => r.json())
                    .then(function (data) {
                        if (data.success) {
                            mostrarSpinnerYMensaje({
                                mensajeExito: 'Los permisos fueron actualizados correctamente.',
                                callbackFinal: () => location.reload()
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.mensaje || 'No se pudieron guardar los permisos.',
                                confirmButtonText: 'Aceptar'
                            });
                        }
                    })
                    .catch(function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error del servidor',
                            text: 'Ocurrió un error inesperado al guardar los permisos.',
                            confirmButtonText: 'Aceptar'
                        });
                    });
                });
            });
        })();
    </script>
}
