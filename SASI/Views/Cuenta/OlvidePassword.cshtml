@model SASI.Models.OlvidePasswordViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_LayoutLogin";

    var nombreSistema = (Model.NombreSistema ?? string.Empty).Trim();
}

@section Styles {
    <style>
        .rec-wrap {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            background: linear-gradient(145deg, #0b1f4b 0%, #14306e 45%, #1d4ed8 100%);
            font-family: "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        .rec-card {
            width: 100%;
            max-width: 480px;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 18px 45px rgba(2, 6, 23, 0.35);
            padding: 2.25rem;
        }

        .rec-badge {
            width: 56px;
            height: 56px;
            display: grid;
            place-items: center;
            margin: 0 auto 1rem;
            border-radius: 16px;
            font-size: 1.6rem;
            color: #1d4ed8;
            background: #e8efff;
        }
    </style>
}

<div class="rec-wrap">
    <div class="rec-card">
        <div class="rec-badge"><i class="bi bi-shield-lock-fill"></i></div>

        <h1 class="h4 fw-bold text-center mb-2">Recuperar contraseña</h1>
        <p class="text-muted text-center mb-4">
            @if (!string.IsNullOrEmpty(nombreSistema))
            {
                <text>Acceso al sistema <strong>@nombreSistema</strong>.<br /></text>
            }
            Ingresa tu correo o nombre de usuario. Un administrador revisará tu solicitud y te entregará una contraseña temporal.
        </p>

        <form asp-action="OlvidePassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ClientId" />
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Identificador" class="form-label"></label>
                <input asp-for="Identificador" class="form-control" placeholder="correo@dominio.com o usuario" autofocus autocomplete="username" />
                <span asp-validation-for="Identificador" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Mensaje" class="form-label">Mensaje (opcional)</label>
                <textarea asp-for="Mensaje" class="form-control" rows="3" maxlength="500" placeholder="Detalle adicional para el administrador"></textarea>
                <span asp-validation-for="Mensaje" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Enviar solicitud</button>

            <div class="text-center mt-3">
                <a href="@Url.Content("~/Cuenta/Login")" class="small text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Volver al inicio de sesión
                </a>
            </div>
        </form>
    </div>
</div>
